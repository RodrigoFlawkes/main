# Padronização de finais de linha e arquivos binários entre Windows e Linux (Codex Cloud / CI).
* text=auto

# Código, documentação, configuração e recursos XML/RESX em LF para evitar diffs ruidosos entre ambientes.
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.resx text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts nativos de Windows em CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Arquivos binários (imagens, ícones e áudio) não devem sofrer conversão de quebra de linha.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.zip binary